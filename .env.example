# Optional live-test inputs. Copy to .env.test and fill in private values.
# Load with Node 22's --env-file=.env.test; no dotenv dependency is required.
SLACK_TEST_CHANNEL_ID=
SLACK_PIPA_BOT_USER_ID=
SLACK_USER_TOKEN=
# Separate Pipa profile home for the candidate; configure its app credentials privately.
PIPA_HOME=

# Planned release evaluator: optional bot sender, distinct from Pipa's bot.
# The existing routine evaluator currently uses SLACK_USER_TOKEN instead.
SLACK_SENDER_BOT_TOKEN=
# Planned live release evaluator: choose a connected provider/model privately.
PIPA_TEST_MODEL=
# Planned engine harness: optional explicit qualified binaries instead of its private cache.
PIPA_TEST_V1_BIN=
PIPA_TEST_V2_BIN=
